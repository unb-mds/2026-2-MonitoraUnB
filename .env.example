
# ==========================================
# MONITORAUNB - VARIAVEIS DE AMBIENTE
# ==========================================

# PostgreSQL: usuário inicial/administrador do contêiner
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitora_unb
POSTGRES_USER=monitora
POSTGRES_PASSWORD=substitua_por_uma_senha_segura

# Credenciais limitadas usadas pelo backend FastAPI.
# Crie o papel com 03_setup_usuarios.sql e defina sua senha no PostgreSQL
# com o comando \password monitora_app. Use a mesma senha em DB_PASSWORD.
DB_USER=monitora_app
DB_PASSWORD=substitua_por_outra_senha_segura

# SMTP - Envio de e-mails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
SMTP_USE_TLS=true

# Auth do professor (uma credencial)
# Gere o hash com: python backend/scripts/gerar_hash_senha.py
# Cole o hash em PROFESSOR_PASSWORD_HASH (nunca coloque a senha em texto puro)
PROFESSOR_USERNAME=professor
PROFESSOR_PASSWORD_HASH=
SESSION_SECRET=

